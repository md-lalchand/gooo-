APP_NAME="Aloms English Center LMS"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Comma-separated exact proxy IPs/CIDRs; blank trusts no forwarded headers.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_WEBHOOK_SECRET=

# Required for production shared API rate limiting across all Node instances.
REDIS_URL=redis://127.0.0.1:6379
# Set to the exact number of trusted reverse-proxy hops; leave 0 for direct traffic.
TRUST_PROXY_HOPS=0
